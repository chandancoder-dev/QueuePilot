NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/queuepilot

# Generate a strong random secret locally before setting JWT_SECRET in .env.
# Example: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Local development origin. In production, set this to the exact deployed frontend origin.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated list; can be used instead of or alongside FRONTEND_URL.
CORS_ORIGINS=

# Production requires NODE_ENV=production, MONGODB_URI, JWT_SECRET, and
# FRONTEND_URL or CORS_ORIGINS (for example https://your-project.vercel.app).
